APP_NAME="Opportunity Research Agent"
APP_ENV=development
# Required only when running an LLM agent against a live provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
SEARCH_WEB_PROVIDER=mock
RSS_FEED_URL=https://feeds.bbci.co.uk/news/technology/rss.xml
RSS_SOURCE_NAME=
RSS_USER_AGENT="OpportunityResearchAgent/0.1 (+https://local.dev)"
RSS_MAX_ITEMS=10
RSS_TIMEOUT_SECONDS=8
SEARCH_BASE_URL=https://en.wikipedia.org/w/api.php
SEARCH_SOURCE_NAME="Wikipedia Search"
SEARCH_USER_AGENT="OpportunityResearchAgent/0.1 (+https://local.dev)"
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=8
